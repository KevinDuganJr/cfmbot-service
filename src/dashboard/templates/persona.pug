doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title CFM Stats Madden Exporter - Choose EA Account
    style.
      :root { color-scheme: dark; }
      body {
        background-color: #0a141f;
        color: #e4e9ef;
        font-family: Lato, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      .auth-wrap {
        display: flex;
        justify-content: center;
        padding: 2.5rem 0.75rem;
      }
      .auth-card {
        width: 100%;
        max-width: 40rem;
        background: #101d2e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.75rem;
        padding: 2rem 1.75rem;
        box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.35);
      }
      .brand-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
      }
      .brand-title {
        font-weight: 800;
        font-size: 1.4rem;
        letter-spacing: 0.02em;
        color: #fff;
      }
      .brand-accent { color: #c98a2e; }
      .card-header-plain {
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
      }
      .card-header-plain h4 {
        font-weight: 700;
        margin-bottom: 0;
      }
      .form-control, .form-select {
        background-color: #16283f;
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
      }
      .form-control:focus, .form-select:focus {
        background-color: #16283f;
        border-color: #c98a2e;
        box-shadow: 0 0 0 0.2rem rgba(201, 138, 46, 0.25);
        color: #fff;
      }
      .form-select option { background-color: #16283f; color: #fff; }
      .form-label { color: rgba(255, 255, 255, 0.85); font-weight: 600; }
      .form-text { color: rgba(255, 255, 255, 0.55) !important; }
      .btn-outline-secondary {
        color: #cfd9e4;
        border-color: rgba(255, 255, 255, 0.3);
      }
      .btn-outline-secondary:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.5);
      }
      .btn-success {
        background-color: #3dd68c;
        border-color: #3dd68c;
        color: #0a141f;
        font-weight: 600;
      }
      .btn-success:hover, .btn-success:focus {
        background-color: #4fe89f;
        border-color: #4fe89f;
        color: #0a141f;
      }
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossOrigin="anonymous")
  body(data-bs-theme="dark")
    .auth-wrap
      .auth-card
        .brand-row
          i.bi.bi-diagram-3-fill.brand-accent(style="font-size:1.5rem")
          span.brand-title CFM Stats #[span.brand-accent Madden Exporter]
        .card-header-plain
          h4 Choose EA Account
        form(action="/dashboard/selectLeague" method="POST")
          .mb-3
            label.form-label(for="access") EA Access Token
            input#access.form-control(type="text" name="access_token" value=access_token readonly=true aria-label="EA access token")
            .form-text.mt-1 This token is read-only.
          if discord
            .mb-3
              label.form-label(for="discord") Discord League (debug)
              input#discord.form-control(type="text" name="discord" value=discord readonly=true aria-label="Discord League (debug)")
          .mb-3
            label.form-label(for="selectedPersona") Persona
            select#selectedPersona.form-select(name="selected_persona" required=true)
              each persona in personas
                option(value=`${JSON.stringify(persona)}`) #{persona.displayName} - #{namespaces[persona.namespaceName]} - #{gameConfig[persona.gameYear].label}
          .mb-5
            label.form-label(for="consoleOverride") Console
            select#consoleOverride.form-select(name="console_override")
              each cons in all_consoles
                option(value=`${cons}`) #{cons}
          .d-flex.justify-content-between.mt-3
            a.btn.btn-outline-secondary(href="/dashboard") Back
            button#submit.btn.btn-success(type="submit") Submit EA Account
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css")
