doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title CFM Stats Madden Exporter - Error
    style.
      :root { color-scheme: dark; }
      body {
        background-color: #0a141f;
        color: #e4e9ef;
        font-family: Lato, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      .auth-wrap {
        display: flex;
        justify-content: center;
        padding: 2.5rem 0.75rem;
      }
      .auth-card {
        width: 100%;
        max-width: 40rem;
        background: #101d2e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.75rem;
        padding: 2rem 1.75rem;
        box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.35);
      }
      .brand-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
      }
      .brand-title {
        font-weight: 800;
        font-size: 1.4rem;
        letter-spacing: 0.02em;
        color: #fff;
      }
      .brand-accent { color: #c98a2e; }
      .card-header-plain {
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
      }
      .card-header-plain h4 {
        font-weight: 700;
        color: #f1a3ad;
        margin-bottom: 0;
      }
      .alert-danger {
        background: rgba(220, 53, 69, 0.12);
        border: 1px solid rgba(220, 53, 69, 0.4);
        color: #f1a3ad;
        border-radius: 0.4rem;
      }
      .alert-danger strong { color: #ff8f9c; }
      .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
      }
      .btn-outline-secondary {
        color: #cfd9e4;
        border-color: rgba(255, 255, 255, 0.3);
      }
      .btn-outline-secondary:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.5);
      }
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossOrigin="anonymous")
  body(data-bs-theme="dark")
    .auth-wrap
      .auth-card
        .brand-row
          i.bi.bi-diagram-3-fill.brand-accent(style="font-size:1.5rem")
          span.brand-title CFM Stats #[span.brand-accent Madden Exporter]
        .card-header-plain
          h4 Error!
        if canUnlink
          button.btn.btn-danger.mb-3#unlinkBtn(type="button") Unlink League
        .alert.alert-danger
          strong There was an error in processing:
          br
          | !{error}
        .d-flex.justify-content-between.mt-4
          a.btn.btn-outline-secondary(href="/dashboard") Back to login
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css")
    script.
      document.getElementById('unlinkBtn')?.addEventListener('click', async function () {
        try {
          const response = await fetch(window.location.pathname + '/unlink', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            }
          });

          if (response.ok) {
            window.location.href = '/dashboard';
          } else {
            alert('Failed to unlink league.');
          }
        } catch (error) {
          console.error('Error unlinking league:', error);
          alert('An error occurred while unlinking the league.');
        }
      });
