doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title CFM Stats Madden Exporter - Connect to EA
    style.
      :root { color-scheme: dark; }
      body {
        background-color: #0a141f;
        color: #e4e9ef;
        font-family: Lato, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      .auth-wrap {
        display: flex;
        justify-content: center;
        padding: 2.5rem 0.75rem;
      }
      .auth-card {
        width: 100%;
        max-width: 40rem;
        background: #101d2e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.75rem;
        padding: 2rem 1.75rem;
        box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.35);
      }
      .brand-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
      }
      .brand-title {
        font-weight: 800;
        font-size: 1.4rem;
        letter-spacing: 0.02em;
        color: #fff;
      }
      .brand-accent { color: #c98a2e; }
      .auth-card h4 {
        font-weight: 700;
        margin-bottom: 0;
      }
      .card-header-plain {
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
      }
      .alert-info {
        background: rgba(217, 169, 79, 0.12);
        border: 1px solid rgba(217, 169, 79, 0.4);
        color: #e8c88a;
        border-radius: 0.4rem;
      }
      .alert-warning {
        background: rgba(220, 53, 69, 0.15);
        border: 1px solid rgba(220, 53, 69, 0.5);
        color: #f8d7da;
        border-radius: 0.4rem;
      }
      .alert-info strong { color: #f0c15c; }
      code {
        color: #e0a24a;
        background: rgba(255, 255, 255, 0.06);
        padding: 0.1rem 0.35rem;
        border-radius: 0.25rem;
      }
      hr { border-color: rgba(255, 255, 255, 0.1); }
      .btn-primary {
        background-color: #c98a2e;
        border-color: #c98a2e;
        color: #101d2e;
        font-weight: 600;
      }
      .btn-primary:hover, .btn-primary:focus {
        background-color: #e0a24a;
        border-color: #e0a24a;
        color: #101d2e;
      }
      .btn-secondary {
        background-color: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.25);
        color: #fff;
      }
      .btn-secondary:hover {
        background-color: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.4);
        color: #fff;
      }
      .btn-success {
        background-color: #3dd68c;
        border-color: #3dd68c;
        color: #0a141f;
        font-weight: 600;
      }
      .btn-success:disabled {
        background-color: rgba(61, 214, 140, 0.35);
        border-color: rgba(61, 214, 140, 0.35);
        color: rgba(10, 20, 31, 0.6);
      }
      .form-control {
        background-color: #16283f;
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
      }
      .form-control:focus {
        background-color: #16283f;
        border-color: #c98a2e;
        box-shadow: 0 0 0 0.2rem rgba(201, 138, 46, 0.25);
        color: #fff;
      }
      .form-control::placeholder { color: rgba(255, 255, 255, 0.4); }
      .form-label { color: rgba(255, 255, 255, 0.85); font-weight: 600; }
      .form-text { color: rgba(255, 255, 255, 0.55) !important; }
      .footer-note {
        text-align: center;
        font-style: italic;
        color: rgba(255, 255, 255, 0.45);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 0.75rem;
        margin-top: 1rem;
      }
      .version-note {
        text-align: center;
        color: rgba(255, 255, 255, 0.35);
        font-size: 0.8rem;
        margin-top: 0.75rem;
      }
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossOrigin="anonymous")
  body(data-bs-theme="dark")
    .auth-wrap
      .auth-card
        .brand-row
          i.bi.bi-diagram-3-fill.brand-accent(style="font-size:1.5rem")
          span.brand-title CFM Stats #[span.brand-accent Madden Exporter]
        .card-header-plain
          h4 Connect to EA (one-time setup)
        .alert.alert-info
          strong Please read before continuing:
          |  This setup links the CFM Stats Madden Exporter to your EA Account and your Madden league. It does NOT store your EA Account or console credentials (PSN, Xbox, etc.). It uses secure tokens to maintain the connection.
        
        .alert.alert-warning.mb-3
          strong ⚠️ EXPECT AN ERROR PAGE: 
          | When you complete the EA step, your browser WILL show a "Page Cannot Be Displayed" or "Unable to Connect" error screen starting with #[code http://127.0.0.1]. #[strong This is normal!] Simply copy that broken URL and return here.

        p.mb-0 Follow these steps:
        ol.mt-2
          li Click #[strong Login to EA] below (opens EA in a new tab).
          li Sign in if requested. You will end up on a blank/error page starting with #[code http://127.0.0.1].
          li Copy the full URL from that page's address bar and paste it below.
        hr
        a.btn.btn-primary.me-2(href=url target="_blank" rel="noopener") Login to EA
        form.d-inline(action="/dashboard/retrievePersonas" method="POST")
          .mb-3.mt-3
            label.form-label(for="code") Paste the URL shown in your browser (must start with "http://127.0.0.1")
            .input-group
              input#code.form-control(type="text" name="code" placeholder="e.g. http://127.0.0.1:PORT/..." aria-label="Redirect URL" value="")
              button.btn.btn-secondary(type="button" id="pasteBtn") Paste
            if discord
              input#discord(type="hidden" name="discord" value=discord readonly=true)
            .form-text.mt-1
              | Tip: Copy the full URL from the browser address bar and paste it here.
          .d-flex.justify-content-end
            button#submit.btn.btn-success(type="submit" disabled=true) Continue to Next Step
          .footer-note(role="note")
            | Legally this falls under interoperability. This tool only automates a standard login flow.
        .version-note
          | v#{buildVersion}
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css")
    script.
      (function () {
        const inputElement = document.getElementById('code')
        const btn = document.getElementById('submit')
        const pasteBtn = document.getElementById('pasteBtn')

        function looksLikeLocalRedirect(val) {
          if (!val) return false
          const v = val.trim()
          return v.startsWith('http://127.0.0.1') || v.startsWith('127.0.0.1')
        }

        async function tryAutoPaste() {
          try {
            const text = await navigator.clipboard.readText()
            if (looksLikeLocalRedirect(text)) {
              inputElement.value = text.trim()
              inputElement.dispatchEvent(new Event('input', { bubbles: true }))
            }
          } catch (e) {
            // Permission denied or browser clipboard access limited
          }
        }

        inputElement.addEventListener('input', function () { btn.disabled = !looksLikeLocalRedirect(this.value) })

        pasteBtn.addEventListener('click', async function () {
          try {
            const text = await navigator.clipboard.readText()
            if (text) {
              inputElement.value = text.trim()
              inputElement.dispatchEvent(new Event('input', { bubbles: true }))
            }
          } catch (e) {
            inputElement.focus()
          }
        })

        // Auto-check clipboard when user clicks back into this tab
        window.addEventListener('focus', tryAutoPaste)
      })()